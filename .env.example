# Copy to .env (or set in your hosting environment). All optional — the Settings page can do the same.
PORT=3000
DATA_DIR=./data
# AI_PROVIDER=anthropic            # anthropic | openai | manual | mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1      # Azure: https://<resource>.openai.azure.com/openai/deployments/<deployment>
# OPENAI_MODEL=gpt-4.1
# OPENAI_AUTH_HEADER=Authorization               # Azure: api-key
# OPENAI_API_VERSION=                            # Azure: e.g. 2024-10-21
# OPENAI_TOKEN_PARAM=max_completion_tokens       # older models/Azure: max_tokens
# MAX_OUTPUT_TOKENS=32000
# APP_PASSWORD=                                  # simple Basic auth for the whole app
